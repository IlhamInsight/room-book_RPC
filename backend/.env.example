# Backend Environment Variables
SECRET_KEY=ganti-dengan-secret-key-aman-anda-minimal-50-karakter
DEBUG=False
ALLOWED_HOSTS=*
DATABASE_URL=sqlite:///db.sqlite3
PORT=5000

# Tambahkan domain Anda jika DEBUG=False (contoh: https://booking.domainanda.com,http://localhost:3000)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://localhost:8000

