# Frontend Environment Variables
# =============================================================
# Opsi 1: Backend Terpisah (Sistem Terdistribusi / Domain Berbeda)
# Digunakan jika Backend dihosting terpisah (contoh: di api.domainanda.com)
VITE_RPC_URL=https://api.domainanda.com/api/rpc/
VITE_API_URL=https://api.domainanda.com/api
VITE_DEBUG=false

# =============================================================
# Opsi 2: Development Lokal
# VITE_RPC_URL=http://localhost:8000/api/rpc/
# VITE_API_URL=http://localhost:8000/api
# VITE_DEBUG=true
