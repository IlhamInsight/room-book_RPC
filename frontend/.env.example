# Frontend Environment Variables
# Untuk development lokal (akses langsung ke backend lokal):
VITE_API_URL=http://localhost:8000/api
VITE_RPC_URL=http://localhost:8000/api/rpc/
VITE_DEBUG=false

# Untuk deployment di Home Server dengan Docker / Reverse Proxy Nginx:
# VITE_RPC_URL=/api/rpc/
# VITE_API_URL=/api
